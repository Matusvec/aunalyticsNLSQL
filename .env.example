# --- HTTP server ---
# API_HOST=127.0.0.1
# API_PORT=8000
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# ENVIRONMENT=production
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# --- Storage ---
# DB_DIR=/var/lib/aunalytics/db          # absolute path recommended in production
# HISTORY_DB_PATH=/var/lib/aunalytics/db/query_history.sqlite

# --- Upload limits ---
# MAX_UPLOAD_BYTES=20971520              # 20 MiB
# MAX_UPLOAD_ROWS=1000000
# MAX_REQUEST_BYTES=1048576              # non-upload request body cap

# --- SQL execution limits ---
# SQL_QUERY_TIMEOUT_SECONDS=10
# SQL_PROGRESS_HANDLER_N=1000
# SQL_MAX_ROW_LIMIT=1000

# --- Ollama ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:3b          # leave unset to auto-pick from PREFERRED_OLLAMA_MODELS
# OLLAMA_ATTEMPT_TIMEOUTS=45.0,180.0
# OLLAMA_MODEL_CACHE_TTL_SECONDS=300

# --- Gemini fallback (used when Ollama is unreachable) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=60

# --- Rate limiting (slowapi) ---
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=120/minute
# RATE_LIMIT_ASK=10/minute
# RATE_LIMIT_EXECUTE=30/minute
# RATE_LIMIT_UPLOAD=20/hour
