# Optional override for the Ollama model (defaults to first available preferred model)
# OLLAMA_MODEL=qwen2.5-coder:3b

# Gemini API fallback — used automatically when Ollama is unreachable.
# Leave blank to disable the fallback.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Override CORS origins (comma-separated). Default allows localhost:3000.
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
